# Public (safe for Vercel / browser)
# Project origin only — do NOT append /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: override SIWE domain (defaults to localhost:3000)
# NEXT_PUBLIC_SIWE_DOMAIN=localhost:3000
# Optional display default for monitored vault (dashboard also uses TARGET_WALLET)
# NEXT_PUBLIC_TARGET_WALLET=0xYourTurnkeyManagedWallet
# NEXT_PUBLIC_AGENT_NETWORK=base-sepolia

# Server-only (never NEXT_PUBLIC_*)
# Required for SIWE verify (create/update auth users + profiles)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Used to derive deterministic post-SIWE session password
AUTH_SECRET=generate_a_long_random_string
# Preferred org for multi-membership pick + public SIWE viewer auto-enroll
# (defaults to seed org UUID if unset)
DEFAULT_ORGANIZATION_ID=a0000000-0000-4000-8000-000000000001

# Phase 7 — agent HTTP (manual actions + optional status)
AGENT_BASE_URL=http://127.0.0.1:8787
# AGENT_INTERNAL_SECRET=shared_secret_if_set_on_agent
# Monitored Aave wallet (dashboard position read)
TARGET_WALLET=0xYourTurnkeyManagedWallet
# RPC for live HF (optional; defaults to public testnet RPCs)
# RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
# Set to 1 for live KeeperHub from UI (default is dry-run)
# ACTIONS_LIVE=0
