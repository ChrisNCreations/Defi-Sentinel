# Public (safe for Vercel / browser)
# Project origin only — do NOT append /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: override SIWE domain (defaults to localhost:3000)
# NEXT_PUBLIC_SIWE_DOMAIN=localhost:3000

# Server-only (never NEXT_PUBLIC_*)
# Required for SIWE verify (create/update auth users + profiles)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Used to derive deterministic post-SIWE session password
AUTH_SECRET=generate_a_long_random_string

# Optional: agent HTTP base URL if web proxies manual actions
# AGENT_BASE_URL=http://127.0.0.1:4000
