
# Supabase (agent only — service role never goes to the browser / Vercel public env)
# Required for live role / hard-limits / circuit / audit writes (Phase 3+)
# Project origin only — do NOT append /rest/v1/ (supabase-js adds that itself)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Preferred org when a wallet has memberships in multiple orgs (role lookup)
# DEFAULT_ORGANIZATION_ID=a0000000-0000-4000-8000-000000000001
# Without service role, CLI uses --dry-run-audit automatically for local formula demos

# Default network for decide CLI: base-sepolia | eth-sepolia
AGENT_NETWORK=base-sepolia

# Phase 6 poller — monitored Aave wallet + org for scheduled guardrails/audit
TARGET_WALLET=0xYourTurnkeyManagedWallet
ORGANIZATION_ID=your-supabase-org-uuid
# Optional alias: AGENT_ORG_ID=
# Poll interval (default 6h). Use POLL_INTERVAL_MS for local demos (e.g. 30000)
# POLL_INTERVAL_HOURS=6
# POLL_INTERVAL_MS=30000
# Set to 0 to skip Gemini on scheduled ticks (formula-only)
# POLLER_USE_BRAIN=1

# Aave V3 testnets (defaults baked into shared package if unset)
AAVE_POOL_ADDRESS_BASE_SEPOLIA=0x8bAB6d1b75f19e9eD9fCe8b9BD338844fF79aE27
AAVE_POOL_ADDRESS_ETH_SEPOLIA=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951
RPC_URL_BASE_SEPOLIA=https://sepolia.base.org
RPC_URL_ETH_SEPOLIA=https://rpc.sepolia.org

# Gemini (Phase 5) — gas estimate, NL intent, thought_summary only
GEMINI_API_KEY=
# Default: gemini-2.0-flash (2.5-flash may be unavailable to new API keys)
# GEMINI_MODEL=gemini-2.0-flash

# KeeperHub (Phase 4) — REST https://app.keeperhub.com/api
KEEPERHUB_API_KEY=
KEEPERHUB_WORKFLOW_ID=
# Optional override (default https://app.keeperhub.com/api)
# KEEPERHUB_API_BASE=https://app.keeperhub.com/api
# Transport: rest (default) | mcp
# KEEPERHUB_TRANSPORT=rest
# KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
# Fall back to REST if MCP init/config fails
# KEEPERHUB_MCP_FALLBACK_REST=1
# Set to 1 to map payload without calling execute
# KEEPERHUB_DRY_RUN=0

# Alerts & safety
DISCORD_WEBHOOK_URL=
HARD_GAS_CAP_GWEI=50

# Phase 7 HTTP API (pnpm --filter agent serve)
# AGENT_HTTP_PORT=8787
# AGENT_HTTP_HOST=127.0.0.1
# AGENT_INTERNAL_SECRET=

