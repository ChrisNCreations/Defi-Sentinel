{
  "name": "agent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "decide": "tsx src/index.ts --decide",
    "force-soft": "tsx src/index.ts --force-soft",
    "force-safe": "tsx src/index.ts --force-safe",
    "guard": "tsx src/index.ts --guard",
    "seed-roles": "tsx src/seed-roles.ts",
    "verify-live": "tsx src/verify-live.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@defi-sentinel/shared": "workspace:*",
    "@supabase/supabase-js": "^2.112.0",
    "dotenv": "^16.4.7",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
