    "force-safe": "tsx src/index.ts --force-safe",
    "guard": "tsx src/index.ts --guard",
    "chat": "tsx src/index.ts --chat",
    "agent-doctor": "tsx src/index.ts --doctor",
    "list-workflows": "tsx src/index.ts --list-workflows",
    "kh": "tsx src/index.ts kh",
